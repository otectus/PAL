<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- A push app for the tests: it gives out an address and nothing else. -->
        <receiver android:name="dev.otectus.pal.mobile.FakePushApp" android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.distributor.REGISTER" />
                <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
                <action android:name="org.unifiedpush.android.distributor.MESSAGE_ACK" />
                <action android:name="dev.otectus.pal.test.DELIVER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
