<?xml version="1.0" encoding="utf-8"?>
<!-- Connection and a count only: no title, text or name is ever put here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_background"
    android:theme="@style/Theme.PAL.Widget">
    <!-- A launcher draws this layout with the platform's own ImageView, which knows android:tint only. -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pal_notification"
            android:tint="@color/pal_widget_accent"
            android:importantForAccessibility="no"
            tools:ignore="UseAppTint" />
        <ImageView
            android:id="@+id/widget_attention"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:src="@drawable/widget_attention"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <!-- Both lines shrink to fit, so a short widget or a large font never cuts a word in half. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        tools:ignore="NestedWeights">
        <TextView
            android:id="@+id/widget_count"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="55"
            android:gravity="bottom"
            android:text="@string/widget_open"
            android:textColor="@color/pal_widget_text"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10dp"
            android:autoSizeMaxTextSize="16sp"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="45"
            android:gravity="top"
            android:paddingTop="2dp"
            android:text="@string/widget_not_ready"
            android:textColor="@color/pal_widget_muted"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10dp"
            android:autoSizeMaxTextSize="14sp"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
