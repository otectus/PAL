#!/usr/bin/env python3
"""Idempotently install/remove a sourced hook block. Does not enable telemetry."""
import argparse
import os
from pathlib import Path
import shlex

parser = argparse.ArgumentParser()
parser.add_argument('action', choices=['install', 'uninstall'])
parser.add_argument('shell', choices=['fish', 'bash', 'zsh'])
parser.add_argument('--rc', type=Path)
args = parser.parse_args()
config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home()/'.config'))
rc = args.rc or {'fish': config/'fish/config.fish', 'bash': Path.home()/'.bashrc', 'zsh': Path(os.environ.get('ZDOTDIR', Path.home()))/'.zshrc'}[args.shell]
root = Path(__file__).resolve().parent.parent
integration = root/'shell'/('pal.'+args.shell)
if not integration.exists():
    integration = root/'share/pal/shell'/('pal.'+args.shell)
start, end = '# >>> PAL workspace telemetry >>>', '# <<< PAL workspace telemetry <<<'
text = rc.read_text() if rc.exists() else ''
for label in ('Cere', 'PAL'):
    old_start, old_end = f'# >>> {label} workspace telemetry >>>', f'# <<< {label} workspace telemetry <<<'
    while old_start in text:
        left, rest = text.split(old_start, 1)
        if old_end not in rest:
            raise SystemExit(f'Unterminated {label} block in {rc}.')
        _, right = rest.split(old_end, 1)
        text = left + right.removeprefix('\n')
if args.action == 'install':
    if not integration.is_file():
        raise SystemExit('PAL integration file is missing.')
    text = text.rstrip('\n') + '\n' + start + '\nsource ' + shlex.quote(str(integration)) + '\n' + end + '\n'
rc.parent.mkdir(parents=True, exist_ok=True)
if not rc.exists() or rc.read_text() != text:
    rc.write_text(text)
print('Hook %sed. Open a new shell. Socket cleanup belongs to PAL shutdown; never remove a live socket.' % args.action)
